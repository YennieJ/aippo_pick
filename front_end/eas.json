{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.aippopick.shop",
        "EXPO_PUBLIC_ADMOB_ANDROID_APP_ID": "ca-app-pub-1803199627641141~4474000036",
        "EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_AI_REPORT": "ca-app-pub-1803199627641141/1477590001",
        "EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_HOME": "ca-app-pub-1803199627641141/2193275452",
        "EXPO_PUBLIC_ADMOB_IOS_APP_ID": "ca-app-pub-1803199627641141~2203059911",
        "EXPO_PUBLIC_ADMOB_IOS_REWARDED_AI_REPORT": "ca-app-pub-1803199627641141/9690623539",
        "EXPO_PUBLIC_ADMOB_IOS_NATIVE_HOME": "ca-app-pub-1803199627641141/6352802304"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.aippopick.shop",
        "EXPO_PUBLIC_ADMOB_ANDROID_APP_ID": "ca-app-pub-1803199627641141~4474000036",
        "EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_AI_REPORT": "ca-app-pub-1803199627641141/1477590001",
        "EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_HOME": "ca-app-pub-1803199627641141/2193275452",
        "EXPO_PUBLIC_ADMOB_IOS_APP_ID": "ca-app-pub-1803199627641141~2203059911",
        "EXPO_PUBLIC_ADMOB_IOS_REWARDED_AI_REPORT": "ca-app-pub-1803199627641141/9690623539",
        "EXPO_PUBLIC_ADMOB_IOS_NATIVE_HOME": "ca-app-pub-1803199627641141/6352802304"
      },
      "android": {
        "buildType": "app-bundle"
        // app-bundle은 프로덕션 빌드에서만 사용되므로 개발 빌드에서는 apk로 빌드해야 함
        // "buildType": "apk",
        // "gradleCommand": ":app:assembleRelease"
      }
      // iOS 빌드 이미지는 고정하지 않는다: Expo SDK 54 기본 이미지가 Xcode 26 이라
      // App Store Connect 요건(2026-04-28부터 Xcode 26 / iOS 26 SDK)을 만족한다.
    }
  },
  "submit": {
    // 자동 제출은 "테스트 트랙"까지만: 공개(프로덕션 출시·심사 제출)는 사람이 콘솔에서 직접 한다.
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6759453387"
      }
    }
  }
}
